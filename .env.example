# Core diagnosis uses deterministic agents by default; no LLM key is required.
NETCOOP_USE_LLM=false

# Optional OpenAI-compatible provider for chat and optional LLM reasoning.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# For local Ollama, use for example:
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b
